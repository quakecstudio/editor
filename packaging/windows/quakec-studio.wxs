<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  The MSI of QuakeC Studio (P4-18), built with WiX 5 by packaging/windows/package.sh, which
  fills in @MSI_VERSION@. The upgrade code is the same for every version, so a new MSI
  replaces the old.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="QuakeC Studio" Manufacturer="QuakeC Studio contributors"
      Version="@MSI_VERSION@" UpgradeCode="8C1F5E2A-6B3D-4E7F-9A0C-2D4B6F8E1A3C" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer QuakeC Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="QuakeC Studio">
        <ComponentGroup Id="Files">
          <Component><File Source="quakec-studio.exe" /></Component>
          <Component><File Source="preview-host.exe" /></Component>
          <Component><File Source="quakec-ide.exe" /></Component>
          <Component><File Source="quakec-lsp.exe" /></Component>
          <Component><File Source="LICENSE.txt" /></Component>
          <Component><File Source="NOTICE.txt" /></Component>
          <Component Id="PathEntry" Guid="5E7A1C3B-2D4F-4A6B-8C9E-0F1A2B3C4D5E">
            <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
                Action="set" System="yes" />
          </Component>
        </ComponentGroup>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="3B9D7F1E-5A2C-4E8B-9D6F-1C3A5E7B9D0F">
        <Shortcut Id="AppShortcut" Name="QuakeC Studio"
            Target="[INSTALLFOLDER]quakec-studio.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\QuakeC Studio" Name="StartMenu"
            Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
