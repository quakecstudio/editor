<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-or-later

  The MSI of QuakeC Studio (P4-18), built with WiX 5 by packaging/windows/package.sh, which
  fills in @MSI_VERSION@. The upgrade code is the same for every version, so a new MSI
  replaces the old. The file types it registers are those the macOS Info.plist and the Linux
  MIME types declare: .qc, .qh, .map and .bsp.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="QuakeC Studio" Manufacturer="QuakeC Studio contributors"
      Version="@MSI_VERSION@" UpgradeCode="8C1F5E2A-6B3D-4E7F-9A0C-2D4B6F8E1A3C" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer QuakeC Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="QuakeC Studio" />
    </StandardDirectory>
    <ComponentGroup Id="Files" Directory="INSTALLFOLDER">
      <Component><File Source="quakec-studio.exe" /></Component>
      <!-- The files Explorer offers to open with the app (Open with), passed as its argument.
           The app becomes the default for no type: Windows asks the user, or keeps theirs. -->
      <Component Id="FileTypes" Guid="7D2E4A6C-1B3F-4C5D-8E9A-2F4B6C8D0E1A">
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Source" Value="QuakeC source" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Source\DefaultIcon"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Source\shell\open\command"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Map" Value="Quake map source" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Map\DefaultIcon"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Map\shell\open\command"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Bsp" Value="Quake BSP level" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Bsp\DefaultIcon"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\QuakeCStudio.Bsp\shell\open\command"
            Value="&quot;[INSTALLFOLDER]quakec-studio.exe&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qc\OpenWithProgids" Name="QuakeCStudio.Source"
            Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.qh\OpenWithProgids" Name="QuakeCStudio.Source"
            Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.map\OpenWithProgids" Name="QuakeCStudio.Map"
            Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.bsp\OpenWithProgids" Name="QuakeCStudio.Bsp"
            Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\QuakeC Studio" Name="FileTypes" Type="integer"
            Value="1" KeyPath="yes" />
      </Component>
      <Component><File Source="quakec-engine.exe" /></Component>
      <Component><File Source="quakec-ide.exe" /></Component>
      <Component><File Source="quakec-lsp.exe" /></Component>
      <Component><File Source="LICENSE.txt" /></Component>
      <Component><File Source="NOTICE.txt" /></Component>
      <Component Id="PathEntry" Guid="5E7A1C3B-2D4F-4A6B-8C9E-0F1A2B3C4D5E">
        <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last"
            Action="set" System="yes" />
      </Component>
    </ComponentGroup>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenu" Guid="3B9D7F1E-5A2C-4E8B-9D6F-1C3A5E7B9D0F">
        <Shortcut Id="AppShortcut" Name="QuakeC Studio"
            Target="[INSTALLFOLDER]quakec-studio.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\QuakeC Studio" Name="StartMenu"
            Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main">
      <ComponentGroupRef Id="Files" />
      <ComponentRef Id="StartMenu" />
    </Feature>
  </Package>
</Wix>
