[Desktop Entry]
Type=Application
Name=QuakeC Studio
Comment=QuakeC IDE with its own compiler, live in-game preview and a built-in agent
Exec=quakec-studio %F
Icon=com.quakecstudio.QuakeCStudio
Terminal=false
Categories=Development;IDE;
# No inode/directory, as Zed leaves it out: some desktops then make the app the folder browser.
MimeType=text/x-quakec;text/x-quake-map;application/x-quake-bsp;
StartupWMClass=quakec-studio
