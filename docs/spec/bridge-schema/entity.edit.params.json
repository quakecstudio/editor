{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quakecstudio.com/spec/bridge-schema/entity.edit.params.json",
  "title": "entity/edit request params (BRIDGE-4)",
  "type": "object",
  "properties": {
    "edict": {
      "$ref": "https://quakecstudio.com/spec/bridge-schema/value.json#/$defs/edict"
    },
    "keyvalues": {
      "type": "array",
      "items": {
        "$ref": "https://quakecstudio.com/spec/bridge-schema/value.json#/$defs/keyvalue"
      }
    },
    "map_entity": {
      "type": "integer",
      "minimum": 0,
      "description": "The place of an entity in the map editor's list of the map's entities, the world 0 (BRIDGE-4.13)."
    }
  },
  "required": [
    "keyvalues"
  ],
  "oneOf": [
    {
      "required": [
        "edict"
      ]
    },
    {
      "required": [
        "map_entity"
      ]
    }
  ]
}
