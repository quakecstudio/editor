{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quakecstudio.com/spec/bridge-schema/reload.result.json",
  "title": "reload response result (BRIDGE-4)",
  "type": "object",
  "properties": {
    "migrated": {
      "type": "integer",
      "minimum": 0
    },
    "lost": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "global",
              "field",
              "function"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "reason"
        ]
      }
    },
    "time": {
      "type": "number"
    },
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "global",
              "field",
              "function"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "reason"
        ]
      }
    },
    "breakpoints_cleared": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "description": "The ids of the breakpoints that no longer resolve, which the reload cleared"
    }
  },
  "required": [
    "migrated",
    "lost",
    "time"
  ]
}
