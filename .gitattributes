# Text files are stored with LF line endings and checked out with LF on every OS, so
# rustfmt's newline_style = "Unix" and byte-exact fixtures hold on Windows too.
* text=auto eol=lf

# Binary formats this project reads and writes
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.dat binary
*.lno binary
*.bsp binary
*.mdl binary
*.wad binary
*.lmp binary
*.wav binary

Cargo.lock linguist-generated=true
